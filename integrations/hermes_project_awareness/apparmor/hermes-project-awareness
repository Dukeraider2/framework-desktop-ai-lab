# Install as /etc/apparmor.d/hermes-project-awareness and load in enforce mode.
# Python runtime access is explicit; do not include abstractions/python because
# it grants access to per-user Python packages and caches.
profile hermes-inventory-provider /usr/bin/python3.14 flags=(attach_disconnected) {
  include <abstractions/base>
  /usr/bin/python3.14 ix,
  /usr/lib/python3.14/** r,
  /usr/lib/python3.14/**.so* mr,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3/dist-packages/**.so* mr,
  /usr/lib/@{multiarch}/** r,
  /usr/lib/@{multiarch}/**.so* mr,
  /lib/@{multiarch}/** r,
  /lib/@{multiarch}/**.so* mr,
  /opt/hermes-project-awareness/integrations/** r,
  /etc/hermes-inventory/sources.toml r,
  /etc/os-release r,
  /proc/cpuinfo r,
  /proc/meminfo r,
  /var/lib/dpkg/status r,
  / r,
  /run/hermes-inventory/** rw,
  /run/hermes-audit/** rw,
  deny /home/** rwlkmx,
  deny /root/** rwlkmx,
  deny /etc/hermes-project-awareness/** rwlkmx,
  deny /etc/ssh/** rwlkmx,
  deny /etc/ssl/private/** rwlkmx,
  deny /var/lib/** wklmx,
  deny /opt/hermes-project-awareness/** wklmx,
}


# Install as /etc/apparmor.d/hermes-project-awareness and load in enforce mode.
# Python runtime access is explicit; do not include abstractions/python because
# it grants access to per-user Python packages and caches.
include <tunables/global>
include <tunables/multiarch>
profile hermes-inventory-provider /usr/bin/python3.14 flags=(attach_disconnected) {
  include <abstractions/base>
  /usr/bin/python3.14 ix,
  /usr/lib/python3.14/** r,
  /usr/lib/python3.14/**.so* mr,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3/dist-packages/**.so* mr,
  /usr/lib/@{multiarch}/** r,
  /usr/lib/@{multiarch}/**.so* mr,
  /lib/@{multiarch}/** r,
  /lib/@{multiarch}/**.so* mr,
  /opt/hermes-project-awareness/integrations/** r,
  /etc/hermes-inventory/sources.toml r,
  /etc/os-release r,
  /proc/cpuinfo r,
  /proc/meminfo r,
  /var/lib/dpkg/status r,
  /sys/class/dmi/id/ r,
  /sys/class/dmi/id/sys_vendor r,
  /sys/class/dmi/id/product_name r,
  /sys/class/dmi/id/board_name r,
  /sys/devices/virtual/dmi/id/sys_vendor r,
  /sys/devices/virtual/dmi/id/product_name r,
  /sys/devices/virtual/dmi/id/board_name r,
  /sys/class/drm/ r,
  /sys/class/drm/card[0-9]*/ r,
  /sys/class/drm/card[0-9]*/device/ r,
  /sys/devices/**/vendor r,
  /sys/devices/**/device r,
  /sys/devices/**/mem_info_vram_total r,
  /sys/devices/**/mem_info_vram_used r,
  network inet stream,
  network inet6 stream,
  / r,
  /run/hermes-inventory/** rw,
  /run/hermes-audit/** rw,
  deny /home/** rwlkmx,
  deny /root/** rwlkmx,
  deny /etc/hermes-project-awareness/** rwlkmx,
  deny /etc/ssh/** rwlkmx,
  deny /etc/ssl/private/** rwlkmx,
  deny /var/lib/** wklmx,
  deny /opt/hermes-project-awareness/** wklmx,
}


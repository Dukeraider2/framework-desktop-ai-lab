# Host-local values only. Copy to /etc/hermes-project-awareness/runtime.env;
# root owns it, mode 0640, readable only by the service-group policy.
# These IDs must match the dedicated Hermes gateway/provider service accounts.
HERMES_PROVIDER_CLIENT_UID=
HERMES_GITHUB_PROVIDER_UID=
HERMES_AUDIT_CLIENT_UIDS=

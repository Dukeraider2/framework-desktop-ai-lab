# Non-secret identifiers only. Use a repository-only GitHub App installation.
# Keep the private key out of this file; systemd LoadCredential supplies it.
HERMES_GITHUB_APP_ID=
HERMES_GITHUB_INSTALLATION_ID=
HERMES_PROVIDER_ID=github
HERMES_PROVIDER_SOCKET=/run/hermes-github/provider.sock
HERMES_GITHUB_PROXY_SOCKET=/run/hermes-github-egress/connect.sock

[Unit]
Description=Rootless llama.cpp ROCm Qwen3 Coder 30B inference server

[Container]
Image=docker.io/kyuz0/amd-strix-halo-toolboxes@sha256:5893ef15c436f15bee2378c2b5ecfdf0f6c2c45a07f401a5dd2e3ce4a38edcf4
ContainerName=llama-qwen3-coder
AddDevice=/dev/kfd
AddDevice=/dev/dri
GroupAdd=keep-groups
SeccompProfile=unconfined
SecurityLabelDisable=true
UserNS=keep-id
PublishPort=127.0.0.1:18081:8080
Volume=%h/.local/share/llama.cpp/models:/models:ro
Environment=XDG_CACHE_HOME=/tmp
Exec=llama-server -m /models/Qwen3-Coder-30B.gguf -c 4096 -ngl 999 -fa 1 --load-mode none --host 0.0.0.0 --port 8080 --parallel 1 --verbosity 4

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target

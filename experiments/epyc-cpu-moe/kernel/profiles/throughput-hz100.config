# EXPERIMENTAL only. Measure against stock kernel before concluding any benefit.
# A lower scheduler tick rate can reduce background overhead but may harm latency.
# This kernel-choice group may be overridden by some distro Kconfig dependencies.
CONFIG_HZ_100=y
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
# CONFIG_HZ_1000 is not set
CONFIG_PREEMPT_NONE=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT is not set

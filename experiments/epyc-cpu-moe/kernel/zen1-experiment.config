# Candidate kernel options layered onto existing supported Ubuntu kernel config.
# Verify each is present and correctly resolved for the PINNED Linux source version.
# This is NOT a bootable, tested configuration and MUST NOT be installed automatically.
CONFIG_NUMA=y
CONFIG_NUMA_BALANCING=y
CONFIG_CGROUPS=y
CONFIG_CPUSETS=y
CONFIG_PERF_EVENTS=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_HUGETLBFS=y

[Unit]
Description=Read-only GitHub event poller and durable agent task router
Documentation=file:/opt/hermes-project-awareness/docs/operator-runbook.md
Requires=hermes-github.service
After=hermes-github.service
ConditionPathExists=/etc/hermes-agent-dispatch/authorized-github-actors

[Service]
Type=simple
User=hermes-agent-dispatch
Group=hermes-agent-dispatch
SupplementaryGroups=hermes-github-client
WorkingDirectory=/opt/hermes-project-awareness
Environment=PYTHONPATH=/opt/hermes-project-awareness
ExecStart=/usr/bin/python3.14 -m agents.github_event_poller
Restart=on-failure
RestartSec=5s
UMask=0077
StateDirectory=hermes-agent-dispatch
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=strict
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX
NoExecPaths=/
ExecPaths=/usr/bin/python3.14
ReadOnlyPaths=/opt/hermes-project-awareness /etc/hermes-agent-dispatch/authorized-github-actors /run/hermes-github
ReadWritePaths=/var/lib/hermes-agent-dispatch
AppArmorProfile=hermes-agent-dispatch
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-agent-dispatch

[Install]
WantedBy=multi-user.target

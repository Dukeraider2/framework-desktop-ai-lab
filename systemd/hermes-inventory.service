[Unit]
Description=Hermes read-only Framework AI Lab host inventory provider
Documentation=file:/opt/hermes-project-awareness/docs/deployment.md
Requires=hermes-project-awareness-audit.service
After=hermes-project-awareness-audit.service
ConditionPathExists=/etc/hermes-inventory/sources.toml
ConditionPathExists=/etc/hermes-project-awareness/runtime.env

[Service]
Type=simple
User=hermes-inventory
Group=hermes-inventory-client
SupplementaryGroups=hermes-audit-clients
WorkingDirectory=/opt/hermes-project-awareness
Environment=HERMES_PROVIDER_ID=inventory
Environment=HERMES_PROVIDER_SOCKET=/run/hermes-inventory/provider.sock
EnvironmentFile=/etc/hermes-project-awareness/runtime.env
ExecStart=/usr/bin/python3.14 -m integrations.hermes_project_awareness.provider_service
Restart=on-failure
RestartSec=3s
UMask=0077
RuntimeDirectory=hermes-inventory
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=strict
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX
NoExecPaths=/
ExecPaths=/usr/bin/python3.14
ReadOnlyPaths=/opt/hermes-project-awareness /etc/hermes-inventory/sources.toml /etc/hermes-project-awareness/runtime.env /etc/os-release /proc/cpuinfo /proc/meminfo /var/lib/dpkg/status /
ReadWritePaths=/run/hermes-inventory
AppArmorProfile=hermes-inventory-provider
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-inventory

[Install]
WantedBy=multi-user.target
